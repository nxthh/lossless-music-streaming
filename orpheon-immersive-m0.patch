+        matrix[0, 0] = a11 * invDet
+        matrix[0, 1] = -a01 * invDet
+        matrix[1, 0] = -a10 * invDet
+        matrix[1, 1] = a00 * invDet
+
+        transform(matrix)
+    }
+}

